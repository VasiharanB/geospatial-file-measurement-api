# Geospatial File Measurement API - Environment Configuration Template
# Copy this file to .env to override runtime defaults

# Server Host and Port
HOST=127.0.0.1
PORT=8000
UVICORN_RELOAD=false

# Upload & Resource Limits
MAX_UPLOAD_SIZE_BYTES=26214400          # 25 MB maximum upload size (bytes)
MAX_DECOMPRESSED_SIZE_BYTES=104857600   # 100 MB maximum uncompressed size for ZIP archives (bytes)
MAX_ZIP_COMPRESSION_RATIO=100.0         # Maximum decompression ratio against Zip bombs
UPLOAD_RATE_LIMIT_PER_MINUTE=60         # IP rate limit for expensive file uploads (uploads per minute)
READ_RATE_LIMIT_PER_MINUTE=300          # IP rate limit for lightweight read endpoints (requests per minute)
RATE_LIMIT_PER_MINUTE=300               # Global fallback rate limit (requests per minute)

# Storage & Persistence Paths
GEOSPATIAL_STORAGE_DIR=./storage/uploads
GEOSPATIAL_DB_PATH=./geospatial.db
# SQLite for local development: sqlite:///./geospatial.db
# PostgreSQL for production: postgresql://geospatial_user:password@hostname:5432/geospatial
DATABASE_URL=sqlite:///./geospatial.db

# Developer Platform & Authentication Secrets
API_KEY_PEPPER=gfm_dev_pepper_change_in_production_32char_minimum
AUTH_SECRET_KEY=gfm_session_secret_change_in_production_32chars
AUTH_TOKEN_EXPIRE_DAYS=7

# CORS Configuration
# Set to '*' for permissive development, or comma-separated origins (e.g., http://localhost:3000,http://localhost:5173)
CORS_ORIGINS=*
